# Copy to .env.local (not committed) and fill in from Supabase: Project Settings -> API Keys / Data API.
# Leave empty and the site keeps everything in the browser, as before.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# the publishable key (sb_publishable_...) or the legacy anon key; never the secret / service_role key
VITE_SUPABASE_KEY=
# true once Google sign-in is set up in Supabase (Authentication -> Sign In / Providers)
VITE_SUPABASE_GOOGLE=false
